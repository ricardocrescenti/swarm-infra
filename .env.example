# -----------------------------------------------------------------------------
# Traefik Dashboard
# -----------------------------------------------------------------------------
# URL: https://traefik.${DOMAIN}
# Usuário: admin | Senha sugerida: TraefikDev2025!
# Gere o hash com: htpasswd -nb admin TraefikDev2025!
TRAEFIK_AUTH='admin:$apr1$nmVwvxKX$jUoQy9e4WR8trbmpCN1qt1'

# Nível de log (DEBUG, INFO, WARN, ERROR)
TRAEFIK_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Portainer - Gerenciamento de Docker Swarm
# -----------------------------------------------------------------------------
# URL: https://portainer.${DOMAIN}
# Usuário: admin | Senha sugerida: PortainerDev2025!
# Gere o hash com: htpasswd -nbB admin "PortainerDev2025!" | cut -d ":" -f 2
